# AI Planning Controller（DeepSeek）环境变量样例
#
# ⚠️ 本文件只放**占位符**：⛔ 不写真实密钥、⛔ 不写任何真实学生材料。
# 复制为 `.env` 并由**服务器运行环境**注入；`.env` 不得提交。
#
# ⚠️ 历史对话中出现过的 `sk-` 前缀旧密钥**已作废**：禁止使用、禁止引用、
#    禁止用任何硬编码字符串作为回退。

# 总开关：默认关闭。只有配置与权限验证后才在服务器上打开。
AI_PLANNING_ENABLED=false

# DeepSeek（OpenAI 兼容）配置。密钥只从服务器环境读取，前端永远拿不到。
DEEPSEEK_API_KEY=<inject-on-server>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 有界成本 / 延迟设置（服务端会把取值夹到硬上界内）。
AI_PLANNING_MAX_OUTPUT_TOKENS=1200
AI_PLANNING_REQUEST_TIMEOUT=20
AI_PLANNING_MAX_CALLS_PER_REQUEST=3
AI_PLANNING_MAX_SESSIONS=200
AI_PLANNING_ADOPT_TTL_SECONDS=900
