# 前端本地环境变量示例
#
# 复制为 .env 后按需修改。.env 不会被提交（见 .gitignore 与仓库根目录 .gitignore）。

# 后端地址：Vite 开发/预览服务器把 /api 请求代理到这里。
# 默认值就是 http://127.0.0.1:8000，一般不需要改。
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 可选：让浏览器**直连**后端。留空（推荐）表示走上面的同源代理。
# 注意：一旦填写，请求会跨域，需要后端自行开启 CORS。
# 本轮刻意不修改后端，所以默认留空。
VITE_API_BASE_URL=

# 可选：启用 Real Planning 提交按钮（POST /api/v1/plan）。
# 默认关闭：关闭时按钮不可用，且不会偷偷改调 Mock 接口。
VITE_PLAN_API_ENABLED=false

# 可选：启用「查看依据」解释入口（POST /api/v1/explanation/plan）。
# 默认关闭：关闭时页面不会发出任何解释请求，并明确显示"解释功能未启用"；
# ⛔ 前端不会自行合成解释文本，也不会把规则模板说成 AI 生成。
# 该接口只读，不会改变任何规划结果。
VITE_EXPLANATION_API_ENABLED=false

# 可选：个人规划（GET /api/v1/personal-planning/curriculum-versions 与
# POST /api/v1/personal-planning/plan，**已由后端实现**）。
# 默认关闭。打开后按真实 readiness 展示；未配置已核验目录时后端返回 503
# personal_catalog_not_configured，页面显示"没有已核验版本目录"，
# ⛔ 不会退回固定 Case A 冒充个人结果。
VITE_PERSONAL_PLANNING_API_ENABLED=false

# 可选：**前端预览**个人规划（离线演示 / 界面评审）。
# 打开后只读前端 fixture，界面会醒目标注"仅前端预览 / 未读取已核验目录"。
# ⛔ 与真实请求失败无关：真实失败**不会**回退到预览数据。
# ⚠️ 仅在没有真实已核验目录时用于演示，不得当作真实结果。
VITE_PERSONAL_PLANNING_PREVIEW=false

# 可选：AI 调整真实接口（GET /status 与 POST /{interpret,solve,adopt}）。
# ✅ 后端已在分支 feature/deepseek-planning-controller 实现这四个路径，
#    契约见该分支的 docs/final_upgrade/AI_PLANNING_API_HANDOFF.md。
# ⚠️ 但**部署的后端未必包含**该私有前缀：默认保持 false；
#    打开后若 /status 返回 404，页面显示"尚未部署"，⛔ 不会伪造解析或候选方案。
# ⛔ 前端不计算 plan_digest（由后端算）、不伪造 adopted_plan（后端不返回方案体）。
VITE_AI_PLANNING_API_ENABLED=false

# 可选：**前端预览** AI 调整（离线演示 / 组件演示）。
# 打开后只读前端 fixture，界面醒目标注"仅前端预览 / 非真实模型 / 未调用 Planner"。
# ⛔ 生产请求失败**不会**回退到本预览；⛔ 不得把预览说成真实模型输出。
VITE_AI_PLANNING_PREVIEW=false
