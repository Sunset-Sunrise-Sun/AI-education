{
  "name": "xuehang-zhuanxian-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "学航·转衔 — Phase 2A 最小 Demo 壳层（Vue 3 + TypeScript + Vite，仅消费 Mock 通道）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "node verify_all_scenarios.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
