{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course_offering.schema.json",
  "title": "CourseOffering",
  "type": "object",
  "additionalProperties": false,
  "required": ["course_id", "course_name", "class_id", "weekday", "start_section", "end_section", "weeks", "semester"],
  "properties": {
    "course_id": {"type": "string", "minLength": 1},
    "course_name": {"type": "string", "minLength": 1},
    "class_id": {"type": "string", "minLength": 1},
    "semester": {"type": "string", "minLength": 1},
    "teacher": {"type": ["string", "null"]},
    "credit": {"type": ["number", "null"], "minimum": 0},
    "weekday": {"type": "integer", "minimum": 1, "maximum": 7},
    "start_section": {"type": "integer", "minimum": 1},
    "end_section": {"type": "integer", "minimum": 1},
    "weeks": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "campus": {"type": ["string", "null"]},
    "classroom": {"type": ["string", "null"]},
    "capacity": {"type": ["integer", "null"], "minimum": 0},
    "remaining_capacity": {"type": ["integer", "null"], "minimum": 0},
    "source": {"type": ["string", "null"]},
    "data_source": {"type": "string", "enum": ["mock", "real"], "default": "mock"}
  }
}